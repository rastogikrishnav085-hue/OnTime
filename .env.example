# OnTime v2 - Environment Configuration

# Server Port (default: 8000)
ONTIME_PORT=8000

# Assistant AI Engines
# 1. Built-in (offline rule engine, always available)
# 2. Laptop (Ollama local model on localhost:11434)
# 3. Gemini (Google Generative AI)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Backend (Action Board)
# Options: 'sqlite' (local file) or 'supabase' (cloud hosted PostgreSQL)
DATABASE_MODE=sqlite

# Supabase Credentials (optional, only if using Supabase Cloud)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=SUPABASE_KEY=YOUR_SUPABASE_KEY_HERE
